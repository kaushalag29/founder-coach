[
 {
  "annotations": {
   "destructive_hint": false,
   "idempotent_hint": true,
   "open_world_hint": false,
   "read_only_hint": true
  },
  "description": "Search Verified advice, takeaways and talk summaries from YC talks. Each hit has an item_id\nto cite, the speaker, talk, year, a deep link to the exact second, and a verbatim quote. Split a\nmulti-part question and search once per part. When gap_suspected is true, tell the Founder\nthe corpus doesn't cover it rather than answering from memory.",
  "input": {
   "properties": {
    "domains": {
     "anyOf": [
      {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "restrict to these Domains (startup, leadership, ...); several = any of them. Leave out to search all; coach_corpus_status lists the Domains this pack covers",
     "title": "Domains"
    },
    "kinds": {
     "anyOf": [
      {
       "items": {
        "enum": [
         "advice",
         "takeaway",
         "summary"
        ],
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "restrict to these item kinds",
     "title": "Kinds"
    },
    "query": {
     "description": "the question or one part of it",
     "maxLength": 500,
     "minLength": 2,
     "title": "Query",
     "type": "string"
    },
    "response_format": {
     "default": "concise",
     "enum": [
      "concise",
      "detailed"
     ],
     "title": "Response Format",
     "type": "string"
    },
    "stage": {
     "anyOf": [
      {
       "enum": [
        "pre-idea",
        "idea",
        "mvp",
        "pmf",
        "growth",
        "fundraising",
        "scaling",
        "exit"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "boosts advice for this Stage; defaults to the Founder's",
     "title": "Stage"
    },
    "top_k": {
     "default": 5,
     "maximum": 15,
     "minimum": 1,
     "title": "Top K",
     "type": "integer"
    },
    "topics": {
     "anyOf": [
      {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "restrict to talks in these topics",
     "title": "Topics"
    }
   },
   "required": [
    "query"
   ],
   "title": "coach_searchArguments",
   "type": "object"
  },
  "name": "coach_search",
  "output": {
   "$defs": {
    "Hit": {
     "properties": {
      "deep_link": {
       "title": "Deep Link",
       "type": "string"
      },
      "doc_id": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Doc Id"
      },
      "domains": {
       "anyOf": [
        {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "the Domains this item belongs to (startup, leadership, ...)",
       "title": "Domains"
      },
      "item_id": {
       "description": "cite this",
       "title": "Item Id",
       "type": "string"
      },
      "kind": {
       "title": "Kind",
       "type": "string"
      },
      "p_relevant": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "how likely this hit is relevant to the question (0 to 1, semantic mode; calibrated once the pack carries a fitted curve)",
       "title": "P Relevant"
      },
      "page": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "a book chapter's PDF page (cite it as \"PDF p. N\"); `talk` is then the chapter title and `series` the book",
       "title": "Page"
      },
      "quote": {
       "description": "verbatim words from the talk or article (untrusted reference text)",
       "title": "Quote",
       "type": "string"
      },
      "relevance": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Relevance"
      },
      "series": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Series"
      },
      "source_kind": {
       "default": "talk",
       "enum": [
        "talk",
        "article",
        "chapter"
       ],
       "title": "Source Kind",
       "type": "string"
      },
      "speaker": {
       "title": "Speaker",
       "type": "string"
      },
      "stages": {
       "anyOf": [
        {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Stages"
      },
      "start_s": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "description": "seconds into a talk; null for an article (its link opens at the quote)",
       "title": "Start S"
      },
      "talk": {
       "description": "the talk's or article's title",
       "title": "Talk",
       "type": "string"
      },
      "text": {
       "title": "Text",
       "type": "string"
      },
      "topics": {
       "anyOf": [
        {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Topics"
      },
      "year": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "title": "Year"
      }
     },
     "required": [
      "item_id",
      "kind",
      "text",
      "quote",
      "talk",
      "speaker",
      "year",
      "deep_link",
      "start_s"
     ],
     "title": "Hit",
     "type": "object"
    }
   },
   "properties": {
    "coverage": {
     "default": "none",
     "description": "how well the Library answers this: strong = answer with Citations; partial = answer what is covered and say what is not; none = state a Gap. With several Domains it is the weakest one's. A Domain with a higher risk tier needs closer, more independent evidence to count as strong",
     "enum": [
      "strong",
      "partial",
      "none"
     ],
     "title": "Coverage",
     "type": "string"
    },
    "coverage_basis": {
     "default": "provisional",
     "description": "calibrated: the pack carries a curve fitted on graded labels; provisional: default thresholds, treat the borders as soft; keyword: no embeddings, closeness unknown",
     "enum": [
      "calibrated",
      "provisional",
      "keyword"
     ],
     "title": "Coverage Basis",
     "type": "string"
    },
    "coverage_by_domain": {
     "anyOf": [
      {
       "additionalProperties": {
        "type": "string"
       },
       "type": "object"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "coverage of each Domain searched, when the search covers two or more",
     "title": "Coverage By Domain"
    },
    "domain_scores": {
     "anyOf": [
      {
       "additionalProperties": {
        "type": "number"
       },
       "type": "object"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "how close the question is to each Domain (automatic routing only)",
     "title": "Domain Scores"
    },
    "domains_searched": {
     "description": "the Domains these results favour or are limited to; empty: the whole Library",
     "items": {
      "type": "string"
     },
     "title": "Domains Searched",
     "type": "array"
    },
    "gap_suspected": {
     "description": "true when coverage is none: nothing in the corpus is close to the question",
     "title": "Gap Suspected",
     "type": "boolean"
    },
    "hits": {
     "items": {
      "$ref": "#/$defs/Hit"
     },
     "title": "Hits",
     "type": "array"
    },
    "mode": {
     "description": "keyword = models still warming up",
     "enum": [
      "semantic",
      "keyword"
     ],
     "title": "Mode",
     "type": "string"
    },
    "newest_year": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "year of the newest relevant result",
     "title": "Newest Year"
    },
    "note": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Note"
    },
    "query": {
     "title": "Query",
     "type": "string"
    },
    "routing": {
     "default": "none",
     "description": "auto: the server picked the Domains from the question; explicit: the caller's `domains`; none: the whole Library (one Domain, or keyword mode)",
     "enum": [
      "auto",
      "explicit",
      "none"
     ],
     "title": "Routing",
     "type": "string"
    },
    "stage_used": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Stage Used"
    },
    "stale_domains": {
     "description": "Domains whose relevant results are older than the Domain's freshness half-life: say so",
     "items": {
      "type": "string"
     },
     "title": "Stale Domains",
     "type": "array"
    },
    "top_similarity": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "description": "cosine similarity of the closest item (semantic mode)",
     "title": "Top Similarity"
    }
   },
   "required": [
    "query",
    "mode",
    "stage_used",
    "hits",
    "top_similarity",
    "gap_suspected"
   ],
   "title": "SearchOut",
   "type": "object"
  }
 },
 {
  "annotations": {
   "destructive_hint": false,
   "idempotent_hint": true,
   "open_world_hint": false,
   "read_only_hint": true
  },
  "description": "Read one talk: its summary and every Verified advice item and takeaway, each with its\nquote and deep link, in talk order. Use it to check a citation or to see the context of a hit.",
  "input": {
   "properties": {
    "ref": {
     "description": "an item_id from coach_search, or a talk's doc_id",
     "maxLength": 200,
     "minLength": 3,
     "title": "Ref",
     "type": "string"
    }
   },
   "required": [
    "ref"
   ],
   "title": "coach_readArguments",
   "type": "object"
  },
  "name": "coach_read",
  "output": {
   "$defs": {
    "ReadItem": {
     "properties": {
      "deep_link": {
       "title": "Deep Link",
       "type": "string"
      },
      "item_id": {
       "title": "Item Id",
       "type": "string"
      },
      "kind": {
       "title": "Kind",
       "type": "string"
      },
      "quote": {
       "title": "Quote",
       "type": "string"
      },
      "start_s": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "title": "Start S"
      },
      "text": {
       "title": "Text",
       "type": "string"
      }
     },
     "required": [
      "item_id",
      "kind",
      "text",
      "quote",
      "deep_link",
      "start_s"
     ],
     "title": "ReadItem",
     "type": "object"
    }
   },
   "properties": {
    "deep_link": {
     "title": "Deep Link",
     "type": "string"
    },
    "doc_id": {
     "title": "Doc Id",
     "type": "string"
    },
    "items": {
     "items": {
      "$ref": "#/$defs/ReadItem"
     },
     "title": "Items",
     "type": "array"
    },
    "series": {
     "title": "Series",
     "type": "string"
    },
    "speaker": {
     "title": "Speaker",
     "type": "string"
    },
    "summary": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Summary"
    },
    "talk": {
     "title": "Talk",
     "type": "string"
    },
    "year": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "title": "Year"
    }
   },
   "required": [
    "doc_id",
    "talk",
    "speaker",
    "year",
    "series",
    "deep_link",
    "summary",
    "items"
   ],
   "title": "ReadOut",
   "type": "object"
  }
 },
 {
  "annotations": {
   "destructive_hint": false,
   "idempotent_hint": true,
   "open_world_hint": false,
   "read_only_hint": true
  },
  "description": "Start here (and add coach_search in the same message when the Founder shares a plan or claim to judge): today's date and ISO week, the Founder profile (stale facts flagged), active Goals,\nthis week's and overdue Commitments, the last Check-in, recent Decisions, and what's due (Nudges),\nand, when the knowledge covers several subjects (Domains), what each is about.\nRecord ids here are what coach_update takes.",
  "input": {
   "properties": {
    "response_format": {
     "default": "concise",
     "enum": [
      "concise",
      "detailed"
     ],
     "title": "Response Format",
     "type": "string"
    }
   },
   "title": "coach_get_contextArguments",
   "type": "object"
  },
  "name": "coach_get_context",
  "output": {
   "properties": {
    "goals": {
     "items": {
      "additionalProperties": true,
      "type": "object"
     },
     "title": "Goals",
     "type": "array"
    },
    "last_checkin": {
     "anyOf": [
      {
       "additionalProperties": true,
       "type": "object"
      },
      {
       "type": "null"
      }
     ],
     "title": "Last Checkin"
    },
    "library": {
     "anyOf": [
      {
       "additionalProperties": true,
       "type": "object"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "the Domains the knowledge pack covers (name, items, what it is about); present only when there are several",
     "title": "Library"
    },
    "nudges": {
     "items": {
      "additionalProperties": true,
      "type": "object"
     },
     "title": "Nudges",
     "type": "array"
    },
    "overdue": {
     "items": {
      "additionalProperties": true,
      "type": "object"
     },
     "title": "Overdue",
     "type": "array"
    },
    "profile": {
     "additionalProperties": true,
     "title": "Profile",
     "type": "object"
    },
    "recent_decisions": {
     "items": {
      "additionalProperties": true,
      "type": "object"
     },
     "title": "Recent Decisions",
     "type": "array"
    },
    "this_week": {
     "items": {
      "additionalProperties": true,
      "type": "object"
     },
     "title": "This Week",
     "type": "array"
    },
    "timezone": {
     "title": "Timezone",
     "type": "string"
    },
    "today": {
     "title": "Today",
     "type": "string"
    },
    "week": {
     "title": "Week",
     "type": "string"
    },
    "week_starts": {
     "title": "Week Starts",
     "type": "string"
    }
   },
   "required": [
    "today",
    "week",
    "week_starts",
    "timezone",
    "profile",
    "goals",
    "this_week",
    "overdue",
    "last_checkin",
    "recent_decisions",
    "nudges"
   ],
   "title": "ContextOut",
   "type": "object"
  }
 },
 {
  "annotations": {
   "destructive_hint": false,
   "idempotent_hint": true,
   "open_world_hint": false,
   "read_only_hint": false
  },
  "description": "Set or confirm Founder profile facts. A changed value keeps the old one in history; re-stating\nan unchanged value confirms it (profile facts go stale after 30 days). Call only after the\nFounder has approved the exact values.",
  "input": {
   "properties": {
    "changes": {
     "additionalProperties": true,
     "description": "field -> value. Fields: company (company name); one_liner (what the company does, in one sentence); customer (who the customer is); stage (one of: pre-idea, idea, mvp, pmf, growth, fundraising, scaling, exit); team_size (number of people working on the company); key_metrics (the few numbers that matter now, e.g. {\"MRR\": \"$4k\", \"design partners\": 3}); timezone (IANA time zone, e.g. Asia/Kolkata); checkin_day (preferred Check-in day: mon, tue, wed, thu, fri, sat, sun)",
     "title": "Changes",
     "type": "object"
    },
    "request_id": {
     "description": "A fresh unique id for this write (e.g. a UUID); reuse it only to retry the same write, which then returns the first result",
     "maxLength": 100,
     "minLength": 1,
     "title": "Request Id",
     "type": "string"
    }
   },
   "required": [
    "changes",
    "request_id"
   ],
   "title": "coach_update_profileArguments",
   "type": "object"
  },
  "name": "coach_update_profile",
  "output": {
   "properties": {
    "confirmed": {
     "items": {
      "type": "string"
     },
     "title": "Confirmed",
     "type": "array"
    },
    "profile": {
     "additionalProperties": true,
     "title": "Profile",
     "type": "object"
    },
    "replayed": {
     "default": false,
     "title": "Replayed",
     "type": "boolean"
    },
    "updated": {
     "items": {
      "type": "string"
     },
     "title": "Updated",
     "type": "array"
    }
   },
   "required": [
    "updated",
    "confirmed",
    "profile"
   ],
   "title": "ProfileOut",
   "type": "object"
  }
 },
 {
  "annotations": {
   "destructive_hint": false,
   "idempotent_hint": true,
   "open_world_hint": false,
   "read_only_hint": false
  },
  "description": "Save one new record. kind \"commitments\" takes 1-3 if-then plans with measurable outcomes (the\nweek's Focus). Citations must be item_ids returned by coach_search or coach_read. Warnings flag\nmore than 3 open Commitments or Goals. Call only after the Founder has approved the exact text.",
  "input": {
   "$defs": {
    "CheckinIn": {
     "properties": {
      "blockers": {
       "items": {
        "type": "string"
       },
       "title": "Blockers",
       "type": "array"
      },
      "kind": {
       "const": "checkin",
       "title": "Kind",
       "type": "string"
      },
      "summary": {
       "title": "Summary",
       "type": "string"
      },
      "wins": {
       "items": {
        "type": "string"
       },
       "title": "Wins",
       "type": "array"
      }
     },
     "required": [
      "kind",
      "summary"
     ],
     "title": "CheckinIn",
     "type": "object"
    },
    "CommitmentIn": {
     "properties": {
      "action": {
       "description": "what the Founder will do",
       "title": "Action",
       "type": "string"
      },
      "citations": {
       "items": {
        "type": "string"
       },
       "title": "Citations",
       "type": "array"
      },
      "cue": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "the 'if/when' of the if-then plan, e.g. 'Monday 9am'",
       "title": "Cue"
      },
      "goal_id": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Goal Id"
      },
      "outcome": {
       "description": "measurable result, e.g. '5 calls booked'",
       "title": "Outcome",
       "type": "string"
      }
     },
     "required": [
      "action",
      "outcome"
     ],
     "title": "CommitmentIn",
     "type": "object"
    },
    "CommitmentsIn": {
     "properties": {
      "items": {
       "items": {
        "$ref": "#/$defs/CommitmentIn"
       },
       "maxItems": 3,
       "minItems": 1,
       "title": "Items",
       "type": "array"
      },
      "kind": {
       "const": "commitments",
       "title": "Kind",
       "type": "string"
      },
      "week": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "ISO week like 2026-W40; default this week",
       "title": "Week"
      }
     },
     "required": [
      "kind",
      "items"
     ],
     "title": "CommitmentsIn",
     "type": "object"
    },
    "DecisionIn": {
     "properties": {
      "citations": {
       "items": {
        "type": "string"
       },
       "title": "Citations",
       "type": "array"
      },
      "kind": {
       "const": "decision",
       "title": "Kind",
       "type": "string"
      },
      "reasoning": {
       "title": "Reasoning",
       "type": "string"
      },
      "revisit_on": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "YYYY-MM-DD to look at it again",
       "title": "Revisit On"
      },
      "text": {
       "title": "Text",
       "type": "string"
      }
     },
     "required": [
      "kind",
      "text",
      "reasoning"
     ],
     "title": "DecisionIn",
     "type": "object"
    },
    "GoalIn": {
     "properties": {
      "citations": {
       "description": "item_ids from coach_search/coach_read",
       "items": {
        "type": "string"
       },
       "title": "Citations",
       "type": "array"
      },
      "kind": {
       "const": "goal",
       "title": "Kind",
       "type": "string"
      },
      "measure": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
