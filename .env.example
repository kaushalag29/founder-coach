# ytbrain / founder-coach settings. Copy to .env (git-ignored) and fill in the REQUIRED block.
#
# How it's read:
# - `ytbrain` loads .env from the repo root at start-up. A variable already set in your shell
#   wins over .env (ytbrain prints a note when they differ). YTBRAIN_DOTENV=0 skips .env.
# - `founder-coach` (the plugin's runtime) reads only the FOUNDER_COACH_* lines, never the keys:
#   from the environment first, then $FOUNDER_COACH_ENV_FILE, ./.env (the folder Claude Code was
#   started in, e.g. this repo), then ~/.founder-coach/.env (a Founder's own settings).
#   `ytbrain claude` also hands this file to `claude plugin eval`, whose sandbox passes only EVAL_*
#   variables (as EVAL_FOUNDER_COACH_ENV_FILE); there the location settings (HOME, MODELS, PACK)
#   are skipped so the eval keeps its own data folder. `founder-coach status` shows what was read.
# - Syntax: `export NAME=value`. A ` # comment` may follow an unquoted value. Don't put a comment
#   after a quoted value (the JSON ones below): the quotes would then be kept.
# - Every commented-out line shows the DEFAULT, the value used when the variable isn't set.
#   Uncomment a line only to change it.

# =============================================================================================
# REQUIRED for the LLM steps: `extract`, `eval build`, `eval judge`, and the judges of
# `eval coach`. Nothing else needs a key (sync, clean, verify, index, search, pack, the plugin).
# Unset, ytbrain uses a local Ollama (backend `ollama`, http://localhost:11434, model
# qwen3:30b-a3b) and no key. Templates for LM Studio, Ollama and NVIDIA NIM are in README.md.
# =============================================================================================
export YTBRAIN_LLM_BACKEND=openai                            # default: ollama   (ollama | openai = any OpenAI-compatible API)
export YTBRAIN_LLM_BASE_URL=https://openrouter.ai/api/v1     # default: http://localhost:11434
export YTBRAIN_LLM_API_KEY=sk-or-v1-REPLACE_ME               # default: none (not needed for a local model)
export YTBRAIN_LLM_MODEL=deepseek/deepseek-v4-flash          # default: qwen3:30b-a3b

# ---------------------------------------------------------------------------------------------
# RECOMMENDED with OpenRouter (optional; the defaults suit a local model)
# ---------------------------------------------------------------------------------------------
export YTBRAIN_LLM_JSON_MODE=response_format    # default: response_format   (| json_object | nvext, legacy NIM)
# JSON merged into every request (provider routing, thinking off). Default: none.
export YTBRAIN_LLM_EXTRA_BODY='{"provider":{"require_parameters":true},"reasoning":{"enabled":false}}'
export YTBRAIN_LLM_WORKERS=5                    # default: 1   (parallel extract calls; `extract --workers` overrides)
export YTBRAIN_LLM_MAX_TOKENS=8192              # default: 8192   (output cap per reply; a record is 2-3k tokens)
export YTBRAIN_SINGLE_CALL_MAX_TOKENS=60000     # default: 20000   (a talk under this is extracted in one call; else ~8k windows)

# ---------------------------------------------------------------------------------------------
# Optional: LLM calls (extract)
# ---------------------------------------------------------------------------------------------
# export YTBRAIN_LLM_MAX_RPM=30                 # default: 30, or 18 for a `:free` model   (shared requests/min; halves on 429s)
# export YTBRAIN_LLM_TIMEOUT_S=900              # default: 900   (one request, end to end)
# export YTBRAIN_LLM_MAX_RETRIES=5              # default: 5   (per request: 429, 5xx, dropped connections, bad payloads)
# export YTBRAIN_LLM_PREFLIGHT_S=20             # default: 20   (per try of the start-up "does the model answer?" check)
# export YTBRAIN_LLM_NUM_CTX=32768              # default: 32768   (Ollama only: its context window)
# export YTBRAIN_EXTRACT_VIDEO_RETRIES=2        # default: 2   (whole-Document retries in extract)

# ---------------------------------------------------------------------------------------------
# Optional: where data lives
# ---------------------------------------------------------------------------------------------
# export YTBRAIN_ROOT=~/ytbrain-data            # default: the repo folder (data/ inside it); move it out of synced folders

# ---------------------------------------------------------------------------------------------
# Optional: YouTube (sync)
# ---------------------------------------------------------------------------------------------
# export YTBRAIN_YT_SLEEP_SUBTITLES=10          # default: 10   (seconds before each caption file; --backfill uses at least 15)
# export YTBRAIN_YT_VIDEO_RETRIES=2             # default: 2   (same video, after the 429 cooldown)
# export YTBRAIN_YTDLP_PROXY=http://host:port   # default: none   (passed to yt-dlp --proxy; never printed; no rotation)
# export YTBRAIN_POT_PROVIDER_URL=http://127.0.0.1:4416               # default: http://127.0.0.1:4416   (bgutil PO-token server)
# export YTBRAIN_POT_SCRIPT_HOME=~/bgutil-ytdlp-pot-provider/server   # default: that path   (bgutil checkout for script mode, no server)

# ---------------------------------------------------------------------------------------------
# Optional: websites (sync of `type: website` Sources)
# ---------------------------------------------------------------------------------------------
# Set your own contact before crawling other people's sites: it's in every request's User-Agent.
# export YTBRAIN_WEB_CONTACT=https://github.com/kaushalag29/founder-coach   # default: this repo's URL
# export YTBRAIN_WEB_USER_AGENT="ytbrain/0.1 (+<contact>; polite research crawler)"   # default: built from YTBRAIN_WEB_CONTACT

# ---------------------------------------------------------------------------------------------
# Optional: Knowledge index and search (`index` extra; PyTorch)
# ---------------------------------------------------------------------------------------------
# export YTBRAIN_DEVICE=auto                    # default: auto   (auto = mps > cuda > cpu | mps | cpu | cuda)
# export YTBRAIN_EMBED_MODEL=BAAI/bge-m3        # default: BAAI/bge-m3   (changing it rebuilds the index)
# export YTBRAIN_RERANK_MODEL=BAAI/bge-reranker-v2-m3   # default: BAAI/bge-reranker-v2-m3   (none disables)

# ---------------------------------------------------------------------------------------------
# Optional: Knowledge pack (`ytbrain pack build`; ONNX via fastembed, no torch)
# ---------------------------------------------------------------------------------------------
# export YTBRAIN_PACK_EMBED_MODEL=BAAI/bge-base-en-v1.5   # default: BAAI/bge-base-en-v1.5
# export YTBRAIN_PACK_RERANK_MODEL=none                  # default: none   (e.g. jinaai/jina-reranker-v1-turbo-en)

# ---------------------------------------------------------------------------------------------
# Optional: eval (`ytbrain eval build|judge|coach`; the models are OpenRouter ids)
# ---------------------------------------------------------------------------------------------
# export YTBRAIN_EVAL_GENERATOR=deepseek/deepseek-v4-flash   # default: YTBRAIN_LLM_MODEL, else deepseek/deepseek-v4-flash
# Two judges from other model families, then a tie-breaker (comma-separated, in that order).
# export YTBRAIN_EVAL_JUDGES=google/gemma-4-31b-it,qwen/qwen3.8-flash,mistralai/mistral-medium-3.1   # default: these three
# export YTBRAIN_EVAL_MAX_COST=5                # default: 5   (USD cap per split, cumulative; a hard stop)
# export YTBRAIN_EVAL_WORKERS=8                 # default: 8   (parallel eval calls)
# export YTBRAIN_EVAL_MAX_RPM=60                # default: 60   (requests/min ceiling; halves on 429s)
# export YTBRAIN_EVAL_TIMEOUT_S=120             # default: 120   (one eval call before it's retried)

# ---------------------------------------------------------------------------------------------
# Optional: Claude Code for plugin development (`ytbrain eval coach`, `ytbrain claude`)
# Runs the local `claude` CLI on your Claude plan. OpenRouter is opt-in (--host openrouter,
# --openrouter) and paid per token.
# ---------------------------------------------------------------------------------------------
# export YTBRAIN_COACH_MODEL=haiku              # default: haiku   (| sonnet | opus | default = your Claude Code setting)
# export YTBRAIN_COACH_HOST_KEY=sk-or-v1-REPLACE_ME   # default: none; falls back to YTBRAIN_LLM_API_KEY when BASE_URL is OpenRouter

# ---------------------------------------------------------------------------------------------
# Optional: the coach runtime (founder-coach; read from the environment, see the top)
# ---------------------------------------------------------------------------------------------
# export FOUNDER_COACH_HOME=~/.founder-coach    # default: ~/.founder-coach   (store, FOUNDER.md, backups, exports, models)
# export FOUNDER_COACH_MODELS=~/.founder-coach/models   # default: $FOUNDER_COACH_HOME/models   (downloaded ONNX models)
# export FOUNDER_COACH_PACK=data/pack           # default: --pack, then the plugin's pack/, the repo's data/pack, ~/.founder-coach/pack
# export FOUNDER_COACH_RERANK=0                 # default: what the pack says (none today)   (1 | 0 forces it on or off)
# export FOUNDER_COACH_GAP_SIMILARITY=0.60      # default: the pack's value, else 0.60 (provisional)   (below it, a likely Gap)
# export FOUNDER_COACH_SEARCH_WAIT_S=20         # default: 20   (seconds a search waits for models still loading, then keywords)
# export FOUNDER_COACH_WARMUP=1                 # default: 1   (0 = don't load models at start; tests)
# export FOUNDER_COACH_LOG=INFO                 # default: INFO   (log level, to stderr)
# export FOUNDER_COACH_USAGE=1                  # default: 1   (0 turns the local usage log off)
# export FOUNDER_COACH_USAGE_TEXT=0             # default: 0   (1 also logs search text; maintainer dogfooding only)
# export FOUNDER_COACH_USAGE_DAYS=90            # default: 90   (usage events older than this are deleted at start-up)

# ---------------------------------------------------------------------------------------------
# Tests and development only (leave unset)
# ---------------------------------------------------------------------------------------------
# export FOUNDER_COACH_ENV_FILE=/path/to/.env   # default: none   (one more settings file for founder-coach, read first)
# export FOUNDER_COACH_DOTENV=0                 # default: files are read   (0 = founder-coach reads the environment only)
# export YTBRAIN_DOTENV=0                       # default: .env is loaded   (0 skips it for ytbrain and founder-coach; the tests set this)
# export FOUNDER_COACH_FAKE_NOW=2026-10-05T09:00:00+05:30   # default: the real clock   (eval personas' simulated weeks)
